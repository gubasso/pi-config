# shellcheck shell=bash
# nix-direnv is recommended for evaluation caching only. It is NOT required
# for GC safety: direnv's own `use_flake` runs `nix print-dev-env --profile
# "$(direnv_layout_dir)/flake-profile"`, and a Nix profile generation is a
# permanent GC root (`createGeneration` -> `addPermRoot`), so the devShell's
# store paths survive `nix-collect-garbage` with or without nix-direnv. Do not
# add a `nix_direnv_version` probe to solve a problem that does not exist.
#
# Interactive shells enter the devShell on `cd`, after a one-time `direnv
# allow`. Non-interactive contexts — CI, agents, editor tasks, `bash -c` — do
# not fire the prompt hook and must wrap commands explicitly:
#     nix develop --command prek run --all-files
#     direnv exec . <cmd>
use flake

# Warn about an old nixpkgs pin in flake.lock, a newer release of a
# tag-pinned input, a newer exobrain CLI, and newer hook-set revisions, and
# once a day about working-tree copies in the Nix store. Each exits 0 and
# moves nothing.
exobrain outdated || true
exobrain store-guard --daily || true

# Developer values live outside the checkout, in
# `$HOME/.config/project-env/pi-config.env`. The file holds values that the
# operator chooses. A credential belongs behind a credential gateway, not in
# an environment variable. The load is silent when the file is absent, so a
# fresh clone needs nothing.
project_env=$HOME/.config/project-env/pi-config.env
if [ -r "$project_env" ]; then source_env "$project_env"; fi
