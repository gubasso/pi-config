{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2024"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "paths": {
      "@earendil-works/pi-coding-agent": ["./.pi-types/dist/index.d.ts"]
    }
  },
  "include": [
    "home/.pi/agent/extensions/**/*.ts",
    "tests/**/*.ts"
  ]
}
