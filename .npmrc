# Nix owns node_modules.
#
# flake.nix builds it from package-lock.json through importNpmLock, and
# linkNodeModulesHook symlinks the result into this tree on shell entry. A
# plain `npm install` would write into a directory whose entries point at the
# read-only Nix store, so it either fails or produces a tree that disagrees
# with the one Nix built, and that tree is replaced on the next shell reload.
#
# This key keeps npm to the half of its job that is still ours: resolve the
# dependency and write package-lock.json. Installation is `direnv reload`.
#
#   npm add -D <pkg>    updates the lockfile only
#   direnv reload       rebuilds node_modules from it
package-lock-only = true
