# Live agent dir mirror. home/.pi/agent/ lands at ${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}.
# The leading slash anchors each name to that one path, not repo-wide, so the
# ignore file states the live tree's shape instead of hiding stray files anywhere.
/home/.pi/agent/auth.json
/home/.pi/agent/web-search.json
/home/.pi/agent/web-search-cache/
/home/.pi/agent/plan-mode.json
/home/.pi/agent/models.json
/home/.pi/agent/mcp-cache.json
/home/.pi/agent/trust.json
/home/.pi/agent/models-store.json
/home/.pi/agent/sessions/
/home/.pi/agent/npm/
/home/.pi/agent/git/
/home/.pi/agent/bin/
/home/.pi/agent/intercom/broker.sock
/home/.pi/agent/intercom/broker.pid
/home/.pi/agent/intercom/broker.port.json
/home/.pi/agent/intercom/broker.spawn.lock
/home/.pi/agent/intercom/broker-launch.vbs
/home/.pi/agent/intercom/pending-asks/
/home/.pi/agent/intercom/extension-state/

# Project-level Pi state written while working in this clone.
# pi-review keeps per-run diffs and manifests here. State, not config.
/.pi/pi-review/

# Repo-wide
__pycache__/
.pytest_cache/
.env
.env.*
!.env.example
node_modules/
*.log

# Nix / direnv
.direnv/
# The devShell symlinks the Pi type definitions here for tsc. Nix owns it.
/.pi-types
/.envrc.local
/result

# lychee link-check verdict cache
.lycheecache
