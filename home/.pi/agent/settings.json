{
  "theme": "dark",
  "defaultProvider": "xai",
  "defaultModel": "grok-4.6",
  "defaultThinkingLevel": "medium",
  "modelThinkingLevels": {
    "xai/grok-4.6": "medium"
  },
  "enableInstallTelemetry": false,
  "lastChangelogVersion": "0.85.1",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:@narumitw/pi-plan-mode",
    "npm:pi-intercom",
    "npm:@99percentpeople/pi-todo",
    "git:github.com/code-yeongyu/pi-lsp-client",
    "git:github.com/code-yeongyu/pi-ast-grep",
    "git:github.com/tmustier/pi-queue-steer",
    "npm:pi-worktrunk",
    "npm:pi-better-edit"
  ],
  "subagents": {
    "defaultThinking": "medium",
    "agentOverrides": {
      "scout": { "thinking": "low" },
      "researcher": { "thinking": "low" },
      "worker": { "model": "inherit", "thinking": "medium" },
      "delegate": { "model": "inherit", "thinking": "medium" },
      "reviewer": { "thinking": "high" },
      "oracle": { "thinking": "high" },
      "evidence-auditor": { "thinking": "high" }
    }
  }
}